#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GLASS_VERSION_MAJOR, GLASS_VERSION_MINOR, GLASS_VERSION_PATCH, 0
PRODUCTVERSION GLASS_VERSION_MAJOR, GLASS_VERSION_MINOR, GLASS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", GLASS_AUTHOR
            VALUE "FileDescription", "Removes DLSS and FSR ghosting from MSFS 2024 glass cockpit displays"
            VALUE "FileVersion", GLASS_VERSION_STRING
            VALUE "InternalName", "glass-cockpit-dlss-fix"
            VALUE "LegalCopyright", "Copyright (c) 2026 IFreemz. MIT license."
            VALUE "OriginalFilename", "glass-cockpit-dlss-fix.addon64"
            VALUE "ProductName", GLASS_NAME
            VALUE "ProductVersion", GLASS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
