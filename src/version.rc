#include <winver.h>
#include "version.h"

// Built twice: the standalone dxgi.dll, and with GLASS_RESHADE_ADDON the ReShade add-on (its add-on list shows the
// name, author and version).
#ifdef GLASS_RESHADE_ADDON
#define GLASS_FILE_DESCRIPTION "Removes DLSS and FSR ghosting from MSFS 2024 glass cockpit displays"
#define GLASS_FILE_NAME "glass-cockpit-dlss-fix.addon64"
#else
#define GLASS_FILE_DESCRIPTION "Glass Cockpit DLSS Fix (standalone) for MSFS 2024, installed as dxgi.dll"
#define GLASS_FILE_NAME "dxgi.dll"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION GLASS_VERSION_MAJOR, GLASS_VERSION_MINOR, GLASS_VERSION_PATCH, 0
PRODUCTVERSION GLASS_VERSION_MAJOR, GLASS_VERSION_MINOR, GLASS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", GLASS_AUTHOR
            VALUE "FileDescription", GLASS_FILE_DESCRIPTION
            VALUE "FileVersion", GLASS_VERSION_STRING
            VALUE "InternalName", "glass-cockpit-dlss-fix"
            VALUE "LegalCopyright", "Copyright (c) 2026 IFreemz. MIT license."
            VALUE "OriginalFilename", GLASS_FILE_NAME
            VALUE "ProductName", GLASS_NAME
            VALUE "ProductVersion", GLASS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
